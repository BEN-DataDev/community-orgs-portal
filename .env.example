# Copy the relevant section into the file named in each heading. Every one of
# those files is git-ignored; this template is the only tracked one.


# ---------------------------------------------------------------------------
# .env.local (development) and .env.production
#
# Read by the application at build and run time.
# ---------------------------------------------------------------------------

# Supabase, client-side. Safe to ship to the browser: the anon key grants
# nothing on its own, because row-level security decides what it can see.
PUBLIC_SUPABASE_URL=<your_supabase_project_url>
PUBLIC_SUPABASE_ANON_KEY=<your_supabase_anon_key>

# Supabase, server-side only. This one bypasses row-level security entirely,
# so it must never reach the browser. Read by src/routes/api/cron/+server.ts.
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=<your_supabase_service_role_key>

# Shared secret for the cron endpoint, which compares it against the
# Authorization header. The route fails closed when this is unset, so the
# scheduled job returns 401 until it is configured.
CRON_SECRET=<a_long_random_string>

# MapTiler key for the operations map. Read through $env/dynamic/public, so it
# is needed at run time, not build time. Tiles do not load without it.
PUBLIC_MAPTILER_KEY=<your_maptiler_key>

# Cloudflare Turnstile site key. Rendered on every auth form, not only the
# "browse as a guest" button: Supabase's CAPTCHA setting is project-wide, so with
# it enabled a sign-in or password reset without a token is rejected too.
#
# Public by design — the secret half lives with Supabase, below. The two must be
# set together: [auth.captcha] enabled with no site key here means nobody can
# sign in, and a site key with captcha disabled means the widget is decorative.
#
# For local development use Cloudflare's always-passing test pair:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=<your_turnstile_site_key>


# ---------------------------------------------------------------------------
# .env (also) — Supabase Auth configuration
#
# The application never reads these. They are interpolated by
# supabase/config.toml when the local stack starts, and their hosted
# equivalents are set through the Supabase dashboard rather than from here.
# Kept in one place so the credentials and the intent are on the record.
# ---------------------------------------------------------------------------

# OAuth providers. Each provider's own app must send users back to
# https://<project-ref>.supabase.co/auth/v1/callback — the Supabase endpoint,
# not a route in this application. Locally that is http://127.0.0.1:54511/auth/v1/callback.
#
# The set configured here must match OAUTH_PROVIDERS in src/lib/auth/providers.ts.

# github.com/settings/developers -> OAuth Apps
SUPABASE_AUTH_GITHUB_CLIENT_ID=<your_github_client_id>
SUPABASE_AUTH_GITHUB_SECRET=<your_github_client_secret>

# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). The consent screen must be published; unverified apps are
# capped at 100 users.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=<your_google_client_id>
SUPABASE_AUTH_GOOGLE_SECRET=<your_google_client_secret>

# portal.azure.com -> Entra ID -> App registrations. The secret is the *value*
# shown once on creation, not the secret ID, and it expires — note the date.
SUPABASE_AUTH_AZURE_CLIENT_ID=<your_azure_application_client_id>
SUPABASE_AUTH_AZURE_SECRET=<your_azure_client_secret_value>

# discord.com/developers/applications -> OAuth2
SUPABASE_AUTH_DISCORD_CLIENT_ID=<your_discord_client_id>
SUPABASE_AUTH_DISCORD_SECRET=<your_discord_client_secret>

# Cloudflare Turnstile secret key, verified by Supabase Auth. Required while
# anonymous sign-ins are enabled: without it the endpoint is an unauthenticated
# way to add rows to auth.users.
#
# Locally, use 1x0000000000000000000000000000000AA (always passes) paired with
# the test site key above.
TURNSTILE_SECRET_KEY=<your_turnstile_secret_key>

# SMTP for auth emails. Only needed once [auth.email.smtp] is uncommented in
# supabase/config.toml; local development uses the Inbucket test server at
# http://127.0.0.1:54514 instead. For Resend the SMTP password is an API key.
RESEND_API_KEY=<your_resend_api_key>


# ---------------------------------------------------------------------------
# .env
#
# Developer tooling only — the application never reads these. They are what
# the committed .mcp.json interpolates, so the MCP servers fail to start
# without them.
# ---------------------------------------------------------------------------

# Supabase management API token and the project it targets.
SUPABASE_ACCESS_TOKEN=<your_supabase_personal_access_token>
SUPABASE_PROJECT_REF=<your_supabase_project_ref>

# GitHub personal access token for the GitHub MCP server.
GITHUB_BENDATADEV_PERSONAL_ACCESS_TOKEN=<your_github_personal_access_token>
