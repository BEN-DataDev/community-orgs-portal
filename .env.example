# Supabase — client-side. Safe to expose; the anon key is constrained by RLS.
PUBLIC_SUPABASE_URL=<your_supabase_project_url>
PUBLIC_SUPABASE_ANON_KEY=<your_supabase_anon_key>

# Supabase — server-side only. Bypasses row-level security entirely.
# Read by src/routes/api/cron/+server.ts.
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=<your_supabase_service_role_key>

# Shared secret for the cron endpoint. It fails closed when unset, so the
# scheduled job will 401 until this is configured in the deployment.
CRON_SECRET=<a_long_random_string>

# MapTiler key for the operations map. Tiles and geocoding fail without it.
PUBLIC_MAPTILER_KEY=<your_maptiler_key>

# GitHub OAuth. Consumed by Supabase Auth configuration, not by the app itself.
SUPABASE_AUTH_GITHUB_CLIENT_ID=<your_github_client_id>
SUPABASE_AUTH_GITHUB_SECRET=<your_github_client_secret>
SUPABASE_AUTH_GITHUB_REDIRECT_URI=<your_github_redirect_uri>
